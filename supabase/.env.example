# Edge Function secrets — `npx supabase secrets set --env-file supabase/.env`
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY автоматаар байдаг)

# sandbox = QPay туршилтын орчин, mock = QPay-гүй demo (Төлбөр шалгах дарахад төлөгдөнө)
QPAY_MODE=sandbox
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=TEST_MERCHANT
QPAY_CLIENT_SECRET=123456
QPAY_INVOICE_CODE=TEST_INVOICE
